# Apenas desenvolvimento local. Substitua o marcador nos dois locais pela mesma
# senha aleatória (use caracteres hexadecimais para não precisar escapar a URL).
POSTGRES_DB=visaoativa
POSTGRES_USER=visaoativa
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_LOCAL
DATABASE_URL=postgresql://visaoativa:SUBSTITUA_POR_UMA_SENHA_LOCAL@127.0.0.1:5433/visaoativa?schema=public

# Habilita produtos, vendas e despesas somente em acesso direto local. Não usar proxy/túnel público.
LOCAL_PRODUCTS_ENABLED=false

# Deixe vazio para configurar a conta pela interface no primeiro acesso.
# Opcional: provisionamento externo com npm run admin:provision após as migrações.
# Somente hash scrypt; nunca coloque a senha em configuração pública/Nuxt.
ADMIN_PASSWORD_HASH=
