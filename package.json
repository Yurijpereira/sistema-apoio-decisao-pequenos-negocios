{
  "name": "visaoativa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.21.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "nuxt dev --host 127.0.0.1",
    "build": "nuxt build",
    "preview": "nuxt preview --host 127.0.0.1",
    "postinstall": "nuxt prepare && prisma generate",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "nuxt typecheck && vue-tsc --noEmit -p tsconfig.checks.json",
    "test": "npm run test:server && npm run test:components",
    "test:server": "vitest run --config vitest.server.config.ts",
    "test:components": "vitest run --config vitest.components.config.ts",
    "test:core:offline": "node scripts/test-core-offline.mjs",
    "test:coverage": "npm run test:coverage:server && npm run test:coverage:components",
    "test:coverage:server": "vitest run --config vitest.server.config.ts --coverage",
    "test:coverage:components": "vitest run --config vitest.components.config.ts --coverage",
    "db:validate": "prisma validate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status",
    "test:integration": "npm run test:integration:products && npm run test:integration:operations && npm run test:integration:suggestions && npm run test:integration:auth && npm run test:integration:admin-setup && npm run test:integration:admin-password && npm run test:integration:observability",
    "test:integration:products": "node --env-file-if-exists=.env scripts/check-products.ts",
    "test:integration:operations": "node --env-file-if-exists=.env scripts/check-operations.ts",
    "test:integration:suggestions": "node --env-file-if-exists=.env scripts/check-suggestions.ts",
    "admin:provision": "node scripts/provision-admin.ts",
    "db:seed": "node --env-file=.env scripts/seed-demo.ts",
    "test:integration:auth": "node --env-file-if-exists=.env scripts/check-auth.ts",
    "test:integration:observability": "node --env-file-if-exists=.env scripts/check-observability.ts",
    "test:integration:admin-setup": "node --env-file-if-exists=.env scripts/check-admin-setup.ts",
    "test:integration:admin-password": "node --env-file-if-exists=.env scripts/check-admin-password.ts",
    "security:audit": "node scripts/run-audit.ts",
    "monitor:health": "node scripts/monitor-health.ts",
    "backup:local": "node --env-file=.env scripts/backup-local.ts",
    "backup:verify": "node --env-file=.env scripts/backup-local.ts --verify",
    "test:backup": "node --env-file=.env scripts/check-backup.ts",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write \"{app,server,shared,scripts,tests}/**/*.{ts,vue,css,mjs}\" \"*.{ts,mjs,json,yaml}\" \".github/workflows/*.{yml,yaml}\" \".vscode/*.json\" \".prettierrc.json\"",
    "format:check": "prettier --check \"{app,server,shared,scripts,tests}/**/*.{ts,vue,css,mjs}\" \"*.{ts,mjs,json,yaml}\" \".github/workflows/*.{yml,yaml}\" \".vscode/*.json\" \".prettierrc.json\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.0.0",
    "h3": "^1.15.11",
    "nuxt": "~4.6.1",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.0.0",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vitest/coverage-v8": "5.0.4",
    "@vue/test-utils": "^2.4.6",
    "dotenv": "^17.0.0",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "^27.0.0",
    "prettier": "3.9.10",
    "prisma": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "5.0.4",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
